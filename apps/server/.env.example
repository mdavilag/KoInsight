# ---------------------------------------------------------------------------
# KoInsight - backend (Express) environment
# ---------------------------------------------------------------------------
# Local development: copy this file to `apps/server/.env`
#   cp apps/server/.env.example apps/server/.env
# Every value is optional; the defaults below match the app's built-in
# defaults, so an empty .env works fine.
# ---------------------------------------------------------------------------

# Interface the API server binds to.
HOSTNAME=127.0.0.1

# Port the API server listens on.
# Default: 3000
# NOTE: `npm run dev` forces the backend to 3001 (the Vite dev server owns
# port 3000 and proxies /api + /syncs to it), so this value only takes effect
# for the production start (`node dist/app.js`).
PORT=3000

# Directory for KoInsight data (SQLite databases, uploads, book covers).
# Default (dev): ../../../data     Default (Docker image): /app/data
# DATA_PATH=./data

# Maximum size, in megabytes, for uploaded statistics.sqlite files.
# Default: 100
MAX_FILE_SIZE_MB=100

# ---------------------------------------------------------------------------
# Dashboard authentication (simple, single fixed credential).
# Protects the dashboard/management endpoints. The KOReader plugin sync
# endpoints (/api/plugin/*, KoSync /syncs/*) stay open on purpose.
# ---------------------------------------------------------------------------
# Login username / password for the dashboard.
# Defaults: admin / davila
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Secret used to derive the session cookie token. CHANGE THIS in production.
AUTH_SECRET=koinsight-dev-secret-change-me

# Set to "true" when serving over HTTPS so the session cookie is Secure.
# Default: false
AUTH_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Optional - AI features (OpenAI). Only needed if you use the AI endpoints;
# leave unset to keep them disabled.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_PROJECT_ID=
# OPENAI_ORG_ID=
